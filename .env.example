# Required
ANTHROPIC_API_KEY=your_api_key_here

# Optional
DATABASE_PATH=social_media_agent.db
LOG_LEVEL=INFO

# Comma-separated list of platforms to generate content for
ENABLED_PLATFORMS=twitter,linkedin,instagram,facebook

# Scheduler settings (hours/days)
TREND_RESEARCH_INTERVAL_HOURS=6
CONTENT_GEN_INTERVAL_HOURS=4
POSTS_PER_PLATFORM_PER_DAY=3
